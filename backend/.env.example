# Copy this file to ".env" and set your Postgres connection string.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
#
# A plain "postgresql://..." URL also works — it's auto-upgraded to the psycopg3 driver.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rpa_builder

# Auth — set a long random JWT_SECRET in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=12
# A bootstrap admin user is created on first startup if the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

