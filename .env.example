# Copy to ".env" on the server and fill in real values. Used by docker-compose.
# NOTE: this file is the deployment config for the Docker stack.

# --- Database (your existing Postgres) -------------------------------------
# URL-encode special characters in the password (e.g. '@' -> %40).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@10.130.9.249:5432/RPA_Builder

# --- Auth ------------------------------------------------------------------
# Generate a long random secret, e.g.:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_HOURS=12

# Bootstrap superadmin (created only if the users table is empty).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Networking ------------------------------------------------------------
# Host port the web UI is published on. App will be at http://<server-ip>:<WEB_PORT>
WEB_PORT=3000
